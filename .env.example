# arquivo de exemplo das variaveis de ambiente
# copie pra .env (cp .env.example .env) e preencha com os dados reais
# nao subir o arquivo .env pro git

# dados de conexao do firebase (ficam escondidos no servidor)
FIREBASE_API_KEY="SUA_API_KEY_AQUI"
FIREBASE_AUTH_DOMAIN="almoxarifado-ca3d1.firebaseapp.com"
FIREBASE_PROJECT_ID="almoxarifado-ca3d1"
FIREBASE_STORAGE_BUCKET="almoxarifado-ca3d1.firebasestorage.app"
FIREBASE_MESSAGING_SENDER_ID="714541348140"
FIREBASE_APP_ID="1:714541348140:web:d3403407fa0e2084af2889"
FIREBASE_MEASUREMENT_ID="G-4ZQBMV0DDV"

# seguranca das rotas e senha de admin pra zerar dados
JWT_SECRET="trocar-por-uma-chave-secreta-forte"
ADMIN_MASTER_PIN="78451296300"

# chave de 64 caracteres hex pra criptografia aes-256-gcm
ENCRYPTION_MASTER_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# config de rate limit contra forca bruta
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="250"
AUTH_RATE_LIMIT_MAX_ATTEMPTS="5"
AUTH_LOCKOUT_DURATION_MS="300000"

# porta padrao do servidor
PORT="3000"
NODE_ENV="development"
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="http://localhost:3000"
